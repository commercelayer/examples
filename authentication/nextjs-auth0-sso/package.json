    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-jwt": "^8.0",
    "helmet": "^7.1.0",
    "highlight.js": "^11.9.0",
    "jwks-rsa": "^3.1.0",
