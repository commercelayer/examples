# Commerce Layer credentials for the SPA (public — sales channel token)
# Create a Sales Channel application in the CL dashboard
VITE_CL_CLIENT_ID=your-sales-channel-client-id
# Optional — defaults to commercelayer.io
# VITE_CL_DOMAIN=commercelayer.io

# Your Commerce Layer market scope (e.g. "market:id:AbCdEfGhIj")
VITE_CL_MARKET_SCOPE=market:id:your-market-id

# The SKU code to add to the order automatically
VITE_CL_SKU_CODE=TSHIRTMM000000FFFFFFXLXX

# The mock gateway's base URL
VITE_GATEWAY_URL=http://localhost:3001
