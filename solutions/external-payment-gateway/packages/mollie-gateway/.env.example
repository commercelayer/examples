# Commerce Layer credentials for the gateway (server-side)
CL_CLIENT_ID=your-integration-client-id
CL_CLIENT_SECRET=your-integration-client-secret
# Optional — defaults to commercelayer.io
# CL_DOMAIN=commercelayer.io

# The shared secret generated by Commerce Layer when you created the external gateway
# Found in: Dashboard > Settings > Payment gateways > your gateway > Shared secret
CL_GATEWAY_SHARED_SECRET=your-shared-secret

# The webhook_endpoint_url generated by Commerce Layer for your external gateway
# Found in: Dashboard > Settings > Payment gateways > your gateway > Webhook endpoint URL
CL_WEBHOOK_ENDPOINT_URL=https://core.commercelayer.io/api/external_gateways/xxxx/webhook

# Mollie test API key (starts with test_)
# Found in: Mollie dashboard > Developers > API keys
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of this gateway server reachable by Mollie for webhooks
# Use a tunnel in local dev: ngrok http 3001 → https://abc123.ngrok.io
GATEWAY_PUBLIC_URL=https://gateway.example.com

# Where Mollie redirects the user after payment (your SPA's /return base URL)
APP_RETURN_URL=http://localhost:5173/return

# Port for the gateway server
PORT=3001
